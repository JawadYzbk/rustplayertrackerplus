// Rust Player Intelligence Platform — Prisma Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model AppUser {
  id        String   @id
  createdAt DateTime @default(now())

  // Persistent FCM Credentials for Rust+ Pairing
  fcmAndroidId     String?
  fcmSecurityToken String?
  fcmSteamId       String?
  fcmIssuedAt      DateTime?
  fcmExpiresAt     DateTime?

  // Customization
  notificationPrefix String @default("[Tracker]")
  commandPrefix      String @default("!")

  servers     Server[]
  players     Player[]
  devices     SmartDevice[]
  groups      PlayerGroup[]
  sessions    Session[]
  dailyStats  PlayerDailyStat[]
  hourlyStats PlayerHourlyStat[]
}

model Server {
  userId    String
  id        String
  name      String
  createdAt DateTime @default(now())

  // Rust+ Credentials
  rustPlusIp          String?
  rustPlusPort        Int?
  rustPlusPlayerId    String?
  rustPlusPlayerToken String?

  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  players  Player[]
  sessions Session[]
  devices  SmartDevice[]

  @@id([userId, id])
  @@index([userId, createdAt])
}

model SmartDevice {
  userId    String
  id        String   // Entity ID from Rust+
  serverId  String
  name      String
  customCommand String? // Custom text to trigger this device
  type      String   // 'switch', 'alarm', etc.
  icon      String?  // Rust item shortname (e.g. smart.switch)
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server  @relation(fields: [userId, serverId], references: [userId, id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, serverId])
}

model Player {
  userId    String
  id        String
  name      String
  serverId  String
  firstSeen DateTime @default(now())
  lastSeen  DateTime
  isTracking Boolean  @default(true)
  rustPlusNotifications Boolean @default(false)

  user        AppUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  server      Server            @relation(fields: [userId, serverId], references: [userId, id], onDelete: Cascade)
  groupId     String?
  group       PlayerGroup?      @relation(fields: [userId, groupId], references: [userId, id], onDelete: SetNull)
  sessions    Session[]
  dailyStats  PlayerDailyStat[]
  hourlyStats PlayerHourlyStat[]

  @@id([userId, id])
  @@index([userId, serverId])
  @@index([userId, groupId])
}

model PlayerGroup {
  userId    String
  id        String
  name      String
  color     String? // Optional hex or tailwind color class
  createdAt DateTime @default(now())

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  players   Player[]

  @@id([userId, id])
  @@index([userId])
}

model Session {
  id          Int       @id @default(autoincrement())
  userId      String
  playerId    String
  serverId    String
  joinedAt    DateTime
  leftAt      DateTime?
  durationSec Int?

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player  @relation(fields: [userId, playerId], references: [userId, id], onDelete: Cascade)
  server Server  @relation(fields: [userId, serverId], references: [userId, id], onDelete: Cascade)

  @@index([userId, playerId, joinedAt])
  @@index([userId, serverId])
  @@index([userId, leftAt])
}

model PlayerDailyStat {
  id            Int      @id @default(autoincrement())
  userId        String
  playerId      String
  date          DateTime @db.Date
  totalTimeSec  Int      @default(0)
  sessionsCount Int      @default(0)

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player  @relation(fields: [userId, playerId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, playerId, date])
  @@index([userId, playerId])
}

model PlayerHourlyStat {
  id           Int    @id @default(autoincrement())
  userId       String
  playerId     String
  hour         Int    // 0-23
  totalTimeSec Int    @default(0)

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player  @relation(fields: [userId, playerId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, playerId, hour])
  @@index([userId, playerId])
}
